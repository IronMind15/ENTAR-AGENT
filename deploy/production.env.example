# 生产环境运行数据建议放在仓库之外，避免源码发布覆盖业务数据。
# 目录必须由部署系统创建并授予容器 appuser（uid 1000）写权限。
ENTAR_ENV=production
ENTAR_STATIC_DATA_DIR=/srv/entar-agent/data
ENTAR_RUNTIME_HOST_DIR=/var/lib/entar-agent/runtime
ENTAR_KB_HOST_DIR=/var/lib/entar-agent/knowledge_base
ENTAR_LOG_HOST_DIR=/var/log/entar-agent
ENTAR_RUNTIME_DIR=/var/lib/entar-agent/runtime
ENTAR_KNOWLEDGE_BASE_DIR=/var/lib/entar-agent/knowledge_base
ENTAR_LOG_DIR=/var/log/entar-agent

# 必填安全项（请通过部署平台 Secret 注入，不要写入本文件）
# ADMIN_PASSWORD=
# DEEPSEEK_API_KEY=
# DINGTALK_CLIENT_ID=
# DINGTALK_CLIENT_SECRET=
