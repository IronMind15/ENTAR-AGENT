# 排除不必要的文件，加速 Docker 构建
.git
.gitignore
.claude
__pycache__
*.pyc
*.pyo
*.md
docs/
venv/
.venv/
*.tar.gz
*.zip
data/
knowledge_base/
# 密钥凭证：local_config.py 含 API Key / 钉钉凭证 / 管理员口令，绝不烧进镜像层
