        <mxCell id="fastapi" value="&lt;b&gt;🔀 FastAPI 统一入口&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;技能注册中心路由&lt;br&gt;高优先级 → 故障查询 · 低优先级 → 通用聊天托底&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0f6;strokeColor=#f72585;strokeWidth=2;fontSize=13;fontColor=#c9184a;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="330" y="190" width="330" height="65" as="geometry" />
        </mxCell>

        <!-- 路由 → 处理层（分叉） -->
