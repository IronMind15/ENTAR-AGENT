        <mxCell id="title" value="&lt;b&gt;恩特小助手 — 系统架构图&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontColor=#1a1a2e;strokeColor=none;fillColor=none;" vertex="1" parent="1">
