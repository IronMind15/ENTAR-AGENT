        <mxCell id="edge-web-router" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4361ee;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="web" target="fastapi">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== Layer 2: 路由层 ===== -->
