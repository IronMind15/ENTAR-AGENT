        <mxCell id="web" value="&lt;b&gt;🌐 Web 页面&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;http://localhost:8000&lt;br&gt;局域网内同事均可访问&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f3ff;strokeColor=#4361ee;strokeWidth=2;fontSize=13;fontColor=#2d47b8;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="540" y="60" width="270" height="70" as="geometry" />
        </mxCell>

        <!-- 用户入口 → 路由 -->
        <mxCell id="edge-dingtalk-router" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4361ee;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dingtalk" target="fastapi">
