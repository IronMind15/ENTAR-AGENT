        </mxCell>

        <!-- ===== Layer 1: 用户入口 ===== -->
        <mxCell id="layer1-label" value="&lt;b&gt;用户入口&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#4361ee;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="30" y="80" width="80" height="24" as="geometry" />
        </mxCell>

        <mxCell id="dingtalk" value="&lt;b&gt;💬 钉钉「恩特小助手」&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;单聊搜索即可使用 · Stream 模式&lt;br&gt;无需公网 IP / 域名 / SSL&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f3ff;strokeColor=#4361ee;strokeWidth=2;fontSize=13;fontColor=#2d47b8;verticalAlign=middle;align=center;" vertex="1" parent="1">
