{
  "meta": {
    "created": "2026-08-04",
    "purpose": "恩特小助手裸检索质量基线（Context Recall）。测的是「检索层能否把正确答案送进 Top-N」——在 Agent 循环里 LLM 会兜底，但检索质量决定 LLM 回答的上限，故单独评估检索层。",
    "match_field": {
      "error_codes": "fault_code",
      "standards": "std_id"
    },
