# ── 本地配置/密钥 ──
scripts/local_config.py
local_config.py

# ── Python ──
__pycache__/
*.pyc
*.pyo

# ── 向量知识库（自动生成，不退版本） ──
knowledge_base/

# ── Office 临时锁文件 ──
~$*

# ── 运行日志 ──
*.log
logs/

# ── IDE ──
.vscode/
.idea/

# ── Word 文档（生成产物，不退版本） ──
docs/*.docx
# 但保留 Markdown 文档
!docs/*.md

# ── 会话记忆（自动生成，不退版本） ──
data/chat_memory.json

# ── 用户信息数据库（SQLite，自动生成，不退版本） ──
data/user_store.db*

# ── 用户上传文件（自动生成，不退版本） ──
data/uploads/

# ── MinerU OCR 中间产物（可重新生成，不退版本） ──
data/standards/mineru_output/

# ── 部署打包产物 ──
*.tar.gz

# ── 本地模型（可重新下载，不退版本） ──
models/

# ── Playwright 临时输出（截图/快照，自动生成） ──
.playwright-mcp/

# ── 临时诊断脚本 ──
data/pcb/_diag_std.py

# ── Claude 本地配置（个人权限，每次使用会变，不进版本库） ──
.claude/settings.local.json
