# ── 本地配置/密钥 ──
scripts/local_config.py
local_config.py

# ── Python ──
__pycache__/
*.pyc
*.pyo

# ── 向量知识库（自动生成，不退版本） ──
knowledge_base/

# ── Office 临时锁文件 ──
~$*

# ── 运行日志 ──
*.log
logs/

# ── IDE ──
.vscode/
.idea/

# ── Word 文档（生成产物，不退版本） ──
docs/*.docx
# 但保留 Markdown 文档
!docs/*.md

# ── 会话记忆（自动生成，不退版本） ──
data/chat_memory.json

# ── 用户上传文件（自动生成，不退版本） ──
data/uploads/

# ── 部署打包产物 ──
*.tar.gz
